programa
{
	  funcao inicio()
	{
		inteiro num 

		escreva("Digite um número: ")
		leia(num)

		se (num >= 18) 
		{
			escreva("Maior de idade")
		} 
		senao 
		{
			escreva("Menor de idade")
		}
	}
}
