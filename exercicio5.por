programa
{
	
	funcao inicio()
	{
		inteiro valorA,valorB,c
		
		escreva("insira o valor de A \n")
		leia(valorA)
		escreva ("o valor de A é :\n",valorA)
		escreva("Insira o valor de B\n")
		leia(valorB)
		escreva("o valor de B é : ",valorB)


		
          se (valorA == valorB){
             c = valorA + valorB
          }
          		senao{ c = valorA * valorB
          		}
          escreva("o valor de C é : ",c)
	}
}
