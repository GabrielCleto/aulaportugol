programa
{
	
	funcao inicio()
	{
	inteiro num

	escreva("insira um valor")
	leia(num)
	escolha (num)
{
    caso 1:
    		escreva("1")
    pare
    caso 2:
    		escreva("2")
    pare
    caso 3:
    		escreva("3")
    pare
    caso 4:
    		escreva("4")
    pare
    caso 5:
    		escreva("5")
    pare
    caso 6:
    		escreva("6")
    pare
    caso contrario: 
    escreva("numero invalido")
}
	}
}
